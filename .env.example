# =============================================================================
# AI PoliceNet - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit the .env file to version control

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=AI-PoliceNet
APP_VERSION=0.1.0
APP_PORT=3000
APP_SECRET=your-app-secret-key-here

# -----------------------------------------------------------------------------
# Database - PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_policenet
POSTGRES_USER=policenet_admin
POSTGRES_PASSWORD=change-this-password

# -----------------------------------------------------------------------------
# Database - MongoDB
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/ai_policenet
MONGODB_DB=ai_policenet

# -----------------------------------------------------------------------------
# Database - Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-this-password

# -----------------------------------------------------------------------------
# Database - Elasticsearch
# -----------------------------------------------------------------------------
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX_PREFIX=policenet

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRY=24h
MFA_ISSUER=AI-PoliceNet
OTP_EXPIRY_MINUTES=5
SESSION_TIMEOUT_MINUTES=30

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ai-policenet
KAFKA_GROUP_ID=policenet-consumers

# -----------------------------------------------------------------------------
# AI Engine
# -----------------------------------------------------------------------------
AI_ENGINE_HOST=localhost
AI_ENGINE_PORT=8000
MODEL_SERVING_HOST=localhost
MODEL_SERVING_PORT=8501
NLP_MODEL_PATH=./ai-engine/models/nlp
CV_MODEL_PATH=./ai-engine/models/cv

# -----------------------------------------------------------------------------
# Blockchain
# -----------------------------------------------------------------------------
BLOCKCHAIN_NETWORK=hyperledger
BLOCKCHAIN_PEER_HOST=localhost
BLOCKCHAIN_PEER_PORT=7051
BLOCKCHAIN_ORDERER_HOST=localhost
BLOCKCHAIN_ORDERER_PORT=7050

# -----------------------------------------------------------------------------
# Notification Services
# -----------------------------------------------------------------------------
SMS_GATEWAY_API_KEY=your-sms-api-key
SMS_GATEWAY_SENDER_ID=AIPNET
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=noreply@ai-policenet.gov
EMAIL_SMTP_PASSWORD=change-this-password
PUSH_NOTIFICATION_KEY=your-push-notification-key

# -----------------------------------------------------------------------------
# Social Media API Keys (for authorized monitoring)
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=your-youtube-api-key
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
INSTAGRAM_API_KEY=your-instagram-api-key

# -----------------------------------------------------------------------------
# Cloud / AWS
# -----------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_EVIDENCE_BUCKET=ai-policenet-evidence
S3_BACKUP_BUCKET=ai-policenet-backups

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=your-256-bit-encryption-key
ENCRYPTION_ALGORITHM=aes-256-gcm
DIGITAL_SIGNATURE_PRIVATE_KEY_PATH=./security/key-management/private.pem
DIGITAL_SIGNATURE_PUBLIC_KEY_PATH=./security/key-management/public.pem

# -----------------------------------------------------------------------------
# Maps & Geolocation
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GEOFENCING_ENABLED=true

# -----------------------------------------------------------------------------
# Identity Verification
# -----------------------------------------------------------------------------
AADHAAR_VERIFICATION_API=your-aadhaar-api-endpoint
IDENTITY_VERIFICATION_KEY=your-identity-verification-key

# -----------------------------------------------------------------------------
# Logging & Monitoring
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json
PROMETHEUS_PORT=9090
GRAFANA_PORT=3003
